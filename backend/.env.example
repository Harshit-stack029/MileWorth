# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
# Not needed when running via `docker compose up` — compose supplies its own
# MongoDB at mongodb://mongo:27017/mileworth. This .env is for running bare.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mileworth?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Default mileage settings for new users (US 2025 IRS standard rate, USD)
DEFAULT_MILEAGE_RATE=0.70
DEFAULT_CURRENCY=USD

# Public URL used inside emailed links (password reset / verification).
APP_PUBLIC_URL=https://mileworth-api.onrender.com

# Outbound email (password reset + email verification). OPTIONAL: if unset,
# emails are logged to the server console instead of sent. Set all four to send
# real mail (e.g. a transactional provider like SendGrid/Mailgun/SES SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MileWorth <no-reply@mileworth.app>

# Google Play subscription verification (OPTIONAL; billing stays 501 until set).
# Paste the full service-account JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.mileworth.app

# DANGER: grants Pro WITHOUT verifying a real purchase. Local development ONLY —
# never set this in a deployed environment. Leave unset/false in production.
ALLOW_MOCK_BILLING=false
