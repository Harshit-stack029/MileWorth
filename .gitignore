# Node
node_modules/
*.log
.env
.env.local

# Android signing — never commit keystores or signing config
app/android/key.properties
*.jks
*.keystore

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.idea/
app/*.iml
app/.packages
# app/pubspec.lock is intentionally NOT ignored: this is an application, not a
# library, so the lockfile is committed to keep CI and release builds resolving
# the same dependency versions as local dev (same reason backend/package-lock.json
# is committed and CI uses `npm ci`).

# OS / editor
.DS_Store
.vscode/
*.swp
